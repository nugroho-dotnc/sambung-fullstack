generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  purchases Contract[]
  notifications Notification[]
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone          String        @unique
  email          String?       @unique
  passwordHash   String?       @map("password_hash")
  role           String
  name           String
  province       String
  regency        String
  district       String
  businessName   String?       @map("business_name")
  status         String        @default("active")
  statusReason   String?       @map("status_reason")
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz(6)
  consentAt      DateTime?     @map("consent_at") @db.Timestamptz(6)
  consentVersion String?       @map("consent_version")
  proExpiresAt         DateTime?             @map("pro_expires_at") @db.Timestamptz(6)
  proReminderSentAt    DateTime?             @map("pro_reminder_sent_at") @db.Timestamptz(6)
  offers Offer[]
  sessions       AuthSession[]
  subscriptionPayments SubscriptionPayment[]

  @@index([role, proExpiresAt], map: "account_pro_expires_at_idx")
  @@map("account")
}

model SubscriptionPayment {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.Uuid
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planCode              String    @default("pembeli_pro_30d") @map("plan_code")
  attempt               Int
  orderId               String    @unique @map("order_id")
  amount                Int       @default(99000)
  durationDays          Int       @default(30) @map("duration_days")
  currency              String    @default("IDR")
  provider              String    @default("midtrans_sandbox")
  status                String    @default("pending")
  paymentType           String?   @map("payment_type")
  paymentChannel        String?   @map("payment_channel")
  paymentReference      String?   @map("payment_reference")
  midtransTransactionId String?   @map("midtrans_transaction_id")
  midtransStatus        String?   @map("midtrans_status")
  fraudStatus           String?   @map("fraud_status")
  snapToken             String?   @map("snap_token")
  redirectUrl           String?   @map("redirect_url")
  rawNotification       Json?     @map("raw_notification")
  periodStart           DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd             DateTime? @map("period_end") @db.Timestamptz(6)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(6)
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)
  lastSyncedAt          DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([accountId, attempt])
  @@index([accountId, createdAt(sort: Desc)])
  @@map("subscription_payment")
}

model OtpChallenge {
  phone       String   @id
  digest      String
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  attempts    Int      @default(0)

  @@map("otp_challenge")
}

model AuthSession {
  tokenHash String   @id @map("token_hash")
  phone     String
  accountId String?  @map("account_id") @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "auth_session_expiry")
  @@map("auth_session")
}

model LegacyMigration {
  name String @id

  @@map("schema_migration")
}
model Region {
  id String @id
  province String
  regency String
  offers Offer[]
}

model Offer {
  contracts Contract[]
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner Account @relation(fields: [ownerId], references: [id])
  districtId String
  region Region @relation(fields: [districtId], references: [id])
  grainType String
  totalVolumeKg Decimal @db.Decimal(14,2)
  askPrice Int
  quality Float?
  availableOn String?
  notes String?
  status String @default("draft")
  version Int @default(1)
  priceCheck Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
  @@index([ownerId])
}

model OfferRequest {
  ownerId String @db.Uuid
  key String
  fingerprint String
  response Json
  @@id([ownerId,key])
}

model Contract {
  id String @id @default(uuid()) @db.Uuid
  offerId String @db.Uuid
  offer Offer @relation(fields:[offerId], references:[id])
  buyerId String @db.Uuid
  buyer Account @relation(fields:[buyerId], references:[id])
  volumeKg Decimal @db.Decimal(14,2)
  farmerAskPrice Int
  status String @default("pending")
  priceOfferVersion Int @default(1)
  currentPrice Int
  currentTurnRole String @default("petani")
  farmerConfirmed Boolean @default(false)
  buyerConfirmed Boolean @default(false)
  farmerSignature String?
  farmerSignatureType String?
  farmerSignedAt DateTime? @db.Timestamptz(6)
  buyerSignature String?
  buyerSignatureType String?
  buyerSignedAt DateTime? @db.Timestamptz(6)
  shippedAt DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  signDeadlineAt DateTime? @map("sign_deadline_at") @db.Timestamptz(6)
  shippingDeadlineAt DateTime? @map("shipping_deadline_at") @db.Timestamptz(6)
  shippingReminderSentAt DateTime? @map("shipping_reminder_sent_at") @db.Timestamptz(6)
  receiptDeadlineAt DateTime? @map("receipt_deadline_at") @db.Timestamptz(6)
  actualVolumeKg Decimal? @map("actual_volume_kg") @db.Decimal(14,2)
  actualMoisturePercent Float? @map("actual_moisture_percent")
  handoverNotes String? @map("handover_notes")
  disputeStatus String @default("none") @map("dispute_status")
  disputeReason String? @map("dispute_reason")
  disputeByRole String? @map("dispute_by_role")
  disputedAt DateTime? @map("disputed_at") @db.Timestamptz(6)
  disputeResolutionNote String? @map("dispute_resolution_note")
  disputeResolvedAt DateTime? @map("dispute_resolved_at") @db.Timestamptz(6)
  disputeResolvedBy String? @map("dispute_resolved_by")
  paymentDueAt DateTime? @map("payment_due_at") @db.Timestamptz(6)
  paymentGraceEndsAt DateTime? @map("payment_grace_ends_at") @db.Timestamptz(6)
  paymentReminderSentAt DateTime? @map("payment_reminder_sent_at") @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  cancelReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history ContractPrice[]
  payments Payment[]
  @@index([offerId,status])
  @@index([buyerId])
  @@index([status, expiresAt])
  @@index([status, signDeadlineAt])
  @@index([status, shippingDeadlineAt])
  @@index([status, receiptDeadlineAt])
  @@index([disputeStatus])
  @@index([status, paymentDueAt, paymentGraceEndsAt])
}
model Payment {
  id                    String    @id @default(uuid()) @db.Uuid
  contractId            String    @map("contract_id") @db.Uuid
  contract              Contract  @relation(fields: [contractId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempt               Int
  orderId               String    @unique @map("order_id")
  contractAmount        BigInt    @map("contract_amount")
  buyerFeeAmount        BigInt    @default(0) @map("buyer_fee_amount")
  grossAmount           BigInt    @map("gross_amount")
  currency              String    @default("IDR")
  provider              String    @default("midtrans_sandbox")
  status                String    @default("pending")
  escrowStatus          String    @default("unpaid") @map("escrow_status")
  paymentType           String?   @map("payment_type")
  paymentChannel        String?   @map("payment_channel")
  paymentReference      String?   @map("payment_reference")
  midtransTransactionId String?   @map("midtrans_transaction_id")
  midtransStatus        String?   @map("midtrans_status")
  fraudStatus           String?   @map("fraud_status")
  snapToken             String?   @map("snap_token")
  redirectUrl           String?   @map("redirect_url")
  rawNotification       Json?     @map("raw_notification")
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(6)
  releasedAt            DateTime? @map("released_at") @db.Timestamptz(6)
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz(6)
  lastSyncedAt          DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([contractId, attempt])
  @@index([contractId, createdAt(sort: Desc)])
  @@map("contract_payment")
}
model ContractPrice {
  id String @id @default(uuid()) @db.Uuid
  contractId String @db.Uuid
  contract Contract @relation(fields:[contractId],references:[id])
  version Int
  role String
  price Int
  note String?
  priceCheck Json
  timestamp DateTime @default(now())
  @@unique([contractId,version])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid @map("account_id")
  account Account @relation(fields: [accountId], references: [id])
  type String
  title String
  description String
  linkHref String? @map("link_href")
  isRead Boolean @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  contractId String? @map("contract_id") @db.Uuid

  @@index([accountId, createdAt])
  @@map("notification")
}

model SystemParameter {
  id String @id @default("active")
  orderExpiryHours Int @default(24) @map("order_expiry_hours")
  fairPriceToleranceDelta Float @default(0.03) @map("fair_price_tolerance_delta")
  rendemenGKP Float @default(0.5338) @map("rendemen_gkp")
  rendemenGKG Float @default(0.6274) @map("rendemen_gkg")
  governmentFloorPriceGKP Int @default(6500) @map("government_floor_price_gkp")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_parameter")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  actorRole String @map("actor_role")
  actorName String @map("actor_name")
  action String
  targetType String @map("target_type")
  targetId String @map("target_id")
  details String

  @@index([timestamp(sort: Desc)])
  @@map("audit_log")
}

model MarketPriceHistory {
  id                     String    @id @default(uuid()) @db.Uuid
  region                 String
  commodity              String    @default("Beras Medium I")
  weekStart              DateTime  @map("week_start") @db.Date
  farmerPrice            Int?      @map("farmer_price")
  millerPrice            Int?      @map("miller_price")
  wholesalePrice         Int?      @map("wholesale_price")
  retailPrice            Int?      @map("retail_price")
  modernPrice            Int?      @map("modern_price")
  predictedFarmerPrice   Int?      @map("predicted_farmer_price")
  predictedMillerPrice   Int?      @map("predicted_miller_price")
  predictedGkpPrice      Int?      @map("predicted_gkp_price")
  predictionLower80      Int?      @map("prediction_lower_80")
  predictionUpper80      Int?      @map("prediction_upper_80")
  predictionHorizonWeeks Int?      @map("prediction_horizon_weeks")
  predictionMethod       String?   @map("prediction_method")
  predictionModelVersion String?   @map("prediction_model_version")
  predictedAt            DateTime? @map("predicted_at") @db.Timestamptz(6)
  source                 String    @default("pihps_bi")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([region, commodity, weekStart])
  @@index([region, weekStart(sort: Desc)])
  @@map("market_price_history")
}

